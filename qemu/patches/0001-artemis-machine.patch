--- a/hw/dma/esp_gdma.c
+++ b/hw/dma/esp_gdma.c
@@ -402,6 +402,141 @@
 
 
 /**
+ * @brief Where a stream is to carry on from: the link address if the channel has been
+ *        started since the last call, the descriptor after the last one otherwise.
+ */
+static uint32_t esp_gdma_stream_position(ESPGdmaState *s, uint32_t chan, uint32_t dir)
+{
+    DmaConfigState* state = &s->ch_conf[dir][chan];
+    const uint32_t start   = (dir == ESP_GDMA_IN_IDX) ? R_GDMA_IN_LINK_START_MASK   : R_GDMA_OUT_LINK_START_MASK;
+    const uint32_t restart = (dir == ESP_GDMA_IN_IDX) ? R_GDMA_IN_LINK_RESTART_MASK : R_GDMA_OUT_LINK_RESTART_MASK;
+    GdmaLinkedList last;
+
+    if (state->link & start) {
+        state->stream_next = ((ESP_GDMA_RAM_ADDR >> 20) << 20) | FIELD_EX32(state->link, GDMA_OUT_LINK, ADDR);
+    } else if ((state->link & restart) && !state->stream_next && state->bfr_desc_addr) {
+        /* A list that had run out may have been extended since */
+        if (esp_gdma_read_descr(s, state->bfr_desc_addr, &last)) {
+            state->stream_next = last.next_addr;
+        }
+    }
+    state->link &= ~(start | restart);
+
+    return state->stream_next;
+}
+
+
+int esp_gdma_stream_out(ESPGdmaState *s, uint32_t chan, uint8_t *buffer, uint32_t size)
+{
+    DmaConfigState* state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
+    const uint32_t addr = esp_gdma_stream_position(s, chan, ESP_GDMA_OUT_IDX);
+    GdmaLinkedList node;
+
+    if (addr == 0) {
+        return -1;
+    }
+
+    if (!esp_gdma_read_descr(s, addr, &node) ||
+        (FIELD_EX32(state->conf1, GDMA_OUT_CONF1, CHECK_OWNER) && !node.config.owner) ||
+        !esp_gdma_read_guest(s, node.buf_addr, buffer, MIN(node.config.length, size)))
+    {
+        esp_gdma_set_status(&state->int_state, R_GDMA_INTERRUPT_OUT_DSCR_ERR_MASK);
+        state->stream_next = 0;
+        return -1;
+    }
+
+    esp_gdma_push_descriptor(s, chan, ESP_GDMA_OUT_IDX, addr);
+    state->stream_desc = addr;
+    state->stream_next = node.next_addr;
+
+    return MIN(node.config.length, size);
+}
+
+
+void esp_gdma_stream_out_done(ESPGdmaState *s, uint32_t chan)
+{
+    DmaConfigState* state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
+    uint32_t status = R_GDMA_INTERRUPT_OUT_DONE_MASK;
+    GdmaLinkedList node;
