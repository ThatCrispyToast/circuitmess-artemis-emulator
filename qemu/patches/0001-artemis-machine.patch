+    state->suc_eof_desc_addr = addr;
+    state->stream_next = node.next_addr;
+    if (state->stream_next == 0) {
+        status |= R_GDMA_INTERRUPT_IN_DSCR_EMPTY_MASK;
+    }
+    esp_gdma_set_status(&state->int_state, status);
