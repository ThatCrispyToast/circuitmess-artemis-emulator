+            [4] = DEVICE(&s->i2s[0]),
+            [7] = DEVICE(&s->i2c[0]),
+            [9] = DEVICE(&s->rmt),
+            [11] = DEVICE(&s->ledc),
+            [21] = DEVICE(&s->i2s[1]),
+            [16] = DEVICE(&s->gpspi[1]),
+            [18] = DEVICE(&s->i2c[1]),
+        };
+
+        for (int bit = 0; bit < 32; bit++) {
+            if (models[bit] && (bits & BIT(bit))) {
