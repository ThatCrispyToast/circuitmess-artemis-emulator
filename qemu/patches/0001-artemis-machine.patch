+/*
+ * With instruction pacing, a device access is charged what it costs the real
+ * machine, and the VM clock stands still for what it costs the host.
+ */
+static bool io_pace_begin(CPUState *cpu, vaddr addr, bool is_write)
+{
+    if (!tcg_insn_pacing || cpu->holds_clock) {
+        return false;
+    }
+    if (tcg_insn_pace_io_cost) {
+        cpu->neg.insn_budget -= tcg_insn_pace_io_cost(addr, is_write);
+    }
+    cpu->holds_clock = true;
+    cpu_clock_hold();
+    return true;
+}
+
+static void io_pace_end(CPUState *cpu, bool held)
+{
+    if (held) {
+        cpu->holds_clock = false;
+        cpu_clock_release();
+    }
+}
