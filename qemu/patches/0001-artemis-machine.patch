+static bool esp32s3_gate_under(Esp32s3PeriphGate *g, hwaddr addr,
+                               MemoryRegion **mr, hwaddr *offset)
+{
+    for (int i = 0; i < g->under_count; i++) {
+        if (addr >= g->under[i].start && addr - g->under[i].start < g->under[i].size) {
+            *mr = g->under[i].mr;
+            *offset = g->under[i].offset + addr - g->under[i].start;
+            return true;
+        }
+    }
+    return false;
+}
+
+static uint64_t esp32s3_gate_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32s3PeriphGate *g = opaque;
+    MemoryRegion *mr;
+    hwaddr offset;
+    uint64_t value = 0;
+
+    if (g->in_reset && g->info->blank_in_reset) {
+        return 0;
+    }
+    if (esp32s3_gate_under(g, addr, &mr, &offset)) {
+        memory_region_dispatch_read(mr, offset, &value, size_memop(size) | MO_LE,
+                                    MEMTXATTRS_UNSPECIFIED);
+    }
+    return value;
+}
+
+static void esp32s3_gate_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    Esp32s3PeriphGate *g = opaque;
+    MemoryRegion *mr;
+    hwaddr offset;
+
+    if (!g->in_reset && g->info->unclocked_writes && esp32s3_gate_under(g, addr, &mr, &offset)) {
+        memory_region_dispatch_write(mr, offset, value, size_memop(size) | MO_LE,
+                                     MEMTXATTRS_UNSPECIFIED);
+    }
+}
