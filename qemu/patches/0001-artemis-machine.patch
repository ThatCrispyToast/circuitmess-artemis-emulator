+/* Sleep stops the count, if the watchdog is set to pause, and waking carries it on. */
+static void esp32s3_rtc_wdt_sleep(Esp32s3RtcCntlState *s, bool asleep)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (!(s->regs[ART_WDTCONFIG0 / 4] & ART_WDT_PAUSE_SLP)) {
+        return;
+    }
+    if (asleep) {
+        s->wdt_paused_after = now - s->wdt_stage_start;
+    } else {
+        s->wdt_stage_start = now - s->wdt_paused_after;
+    }
+    esp32s3_rtc_wdt_arm(s);
+}
