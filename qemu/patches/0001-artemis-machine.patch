+static void esp32s3_periph_gates_changed(void *opaque)
+{
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+
+    for (int i = 0; i < ARRAY_SIZE(s->gates); i++) {
+        Esp32s3PeriphGate *g = &s->gates[i];
+        uint32_t bit = BIT(g->info->bit);
+        bool clocked = s->clock.regs[0x18 / 4 + g->info->reg] & bit;
+
+        g->in_reset = s->clock.regs[0x20 / 4 + g->info->reg] & bit;
+        memory_region_set_enabled(&g->mr, g->in_reset || !clocked);
+    }
+}
+
+static void esp32s3_init_periph_gates(Esp32s3SocState *s, MemoryRegion *sys_mem)
+{
+    for (int i = 0; i < ARRAY_SIZE(s->gates); i++) {
+        Esp32s3PeriphGate *g = &s->gates[i];
+        hwaddr at = 0;
+
+        g->info = &esp32s3_periph_gates[i];
+        while (at < ESP32S3_PERIPH_SIZE && g->under_count < ARRAY_SIZE(g->under)) {
+            MemoryRegionSection found = memory_region_find(sys_mem, g->info->base + at,
+                                                           ESP32S3_PERIPH_SIZE - at);
+            hwaddr start, size;
+
+            if (!found.mr) {
+                break;
+            }
+            start = found.offset_within_address_space - g->info->base;
+            size = int128_get64(found.size);
+            g->under[g->under_count].start = start;
+            g->under[g->under_count].size = size;
+            g->under[g->under_count].mr = found.mr;
+            g->under[g->under_count].offset = found.offset_within_region;
+            g->under_count++;
+            at = start + size;
+        }
+        memory_region_init_io(&g->mr, OBJECT(s), &esp32s3_gate_ops, g, g->info->name,
+                              ESP32S3_PERIPH_SIZE);
+        memory_region_add_subregion_overlap(sys_mem, g->info->base, &g->mr, 10);
+        memory_region_set_enabled(&g->mr, false);
+    }
+    s->clock.periph_gates_changed = esp32s3_periph_gates_changed;
+}
