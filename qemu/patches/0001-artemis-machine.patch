+void esp_gdma_stream_in(ESPGdmaState *s, uint32_t chan, const uint8_t *buffer, uint32_t size)
+{
+    DmaConfigState* state = &s->ch_conf[ESP_GDMA_IN_IDX][chan];
+    const uint32_t addr = state->stream_next;
+    uint32_t status = R_GDMA_INTERRUPT_IN_DONE_MASK | R_GDMA_INTERRUPT_IN_SUC_EOF_MASK;
+    GdmaLinkedList node;
+
+    if (addr == 0 || !esp_gdma_read_descr(s, addr, &node)) {
+        return;
+    }
+
+    size = MIN(size, node.config.size);
+    if (!esp_gdma_write_guest(s, node.buf_addr, (void *) buffer, size)) {
+        esp_gdma_set_status(&state->int_state, R_GDMA_INTERRUPT_IN_DSCR_ERR_MASK);
+        state->stream_next = 0;
+        return;
+    }
+
+    esp_gdma_push_descriptor(s, chan, ESP_GDMA_IN_IDX, addr);
+    node.config.length = size;
+    node.config.owner = 0;
+    node.config.suc_eof = 1;
+    esp_gdma_write_descr(s, addr, &node);
