+#define PACE_SLICE_INSNS    8192
+/* How far behind its pace a CPU may fall before the debt is written off. */
+#define PACE_MAX_LAG_NS     (500 * SCALE_US)
+/* Waits shorter than this are spun out, for the sake of accuracy. */
+#define PACE_SPIN_NS        (60 * SCALE_US)
+#define PACE_MAX_SLEEP_NS   (200 * SCALE_US)
+
+/* The budget ran out: wait until the instructions run since should be done. */
+static void cpu_insn_pace(CPUState *cpu)
+{
+    const uint32_t ps = qatomic_read(&tcg_insn_pace_ps);
+    const int64_t ran = PACE_SLICE_INSNS - cpu->neg.insn_budget;
+    int64_t now = get_clock();
+    int64_t due;
+
+    cpu->neg.insn_budget = PACE_SLICE_INSNS;
+
+    if (!cpu->insn_pace_started) {
+        cpu->insn_pace_started = true;
+        cpu->insn_pace_due = now;
+#ifdef __linux__
+        /* Short sleeps would otherwise be rounded up by 50 us each. */
+        prctl(PR_SET_TIMERSLACK, 1);
+#endif
+        return;
+    }
+    if (ps == 0) {
+        cpu->insn_pace_due = now;
+        return;
+    }
+
+    due = cpu->insn_pace_due + ran * (int64_t)ps / 1000;
+    if (now - due > PACE_MAX_LAG_NS) {
+        /* It had been idle, or the host can't keep up: start again from here. */
+        due = now;
+    }
+    cpu->insn_pace_due = due;
+
+    /* Anything that wants this CPU's attention ends the wait; the time owed stays owed. */
+    while (now < due && !cpu_loop_exit_requested(cpu)) {
+        const int64_t left = due - now;
+
+        if (left > PACE_SPIN_NS) {
+            const struct timespec ts = {
+                .tv_nsec = MIN(left - PACE_SPIN_NS / 2, PACE_MAX_SLEEP_NS),
+            };
+            nanosleep(&ts, NULL);
+        } else {
+            cpu_relax();
+        }
+        now = get_clock();
+    }
+}
