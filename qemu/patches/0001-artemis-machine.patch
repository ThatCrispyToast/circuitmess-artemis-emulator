+/* A core stops while firmware stalls it or the whole chip is clock-gated. */
+static void esp32s3_update_stall(Esp32s3SocState *s, int n)
+{
+    bool stall = s->clock_gated || s->rtc_cntl.cpu_stall_state[n];
+
+    if (stall != s->cpu[n].env.runstall) {
+        xtensa_runstall(&s->cpu[n].env, stall);
+    }
+}
+
 static void esp32s3_cpu_stall(void* opaque, int n, int level)
 {
+    esp32s3_update_stall(ESP32S3_SOC(opaque), n);
+}
+
+static void esp32s3_gate_cores(Esp32s3SocState *s, bool gated)
+{
+    s->clock_gated = gated;
+    for (int i = 0; i < ESP32S3_CPU_COUNT; i++) {
+        esp32s3_update_stall(s, i);
+    }
+    for (int i = 0; i < ARRAY_SIZE(s->timg); i++) {
+        esp_timg_set_clock_gated(ESP_TIMG(&s->timg[i]), gated);
+    }
+}
+
+/* Light and deep sleep clock-gate both cores until a wakeup source fires. */
+static void esp32s3_sleep_stall(void *opaque, int n, int level)
+{
+    esp32s3_gate_cores(ESP32S3_SOC(opaque), level);
+}
+
+/* A watchdog's reset stage, on behalf of timer group n. */
+static void esp32s3_timg_wdt_reset(void *opaque, int n, int level)
+{
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+
+    if (level) {
+        for (int i = 0; i < ESP32S3_CPU_COUNT; i++) {
+            s->rtc_cntl.reset_cause[i] = ESP32_TG0WDT_SYS_RESET + n;
+        }
+        s->requested_reset |= ESP32S3_SOC_RESET_DIG;
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+}
