+/* The baud rate comes of a source clock, its divider, and the fractional divider after it. */
+static void esp32s3_uart_update_baud(ESP32S3UARTState *s)
+{
+    static const uint32_t source_hz[] = { 0, 80000000, 17500000, 40000000 };
+    uint32_t clkdiv = s->parent.reg[A_ESP32S3_UART_CLKDIV / 4];
+    uint32_t conf = s->clk_conf;
+    uint64_t divider = (uint64_t)((clkdiv & 0xFFF) << 4 | (clkdiv >> 20 & 0xF)) * ((conf >> 12 & 0xFF) + 1);
+
+    if (divider && source_hz[conf >> 20 & 3]) {
+        s->parent.baud_rate = ((uint64_t)source_hz[conf >> 20 & 3] << 4) / divider;
+    }
+}
