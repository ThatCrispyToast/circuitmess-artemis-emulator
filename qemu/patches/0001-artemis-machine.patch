+/* Runs on the core concerned, so its helpers never see a half-made change. */
+static void esp32s3_apply_cpu_hz(CPUState *cs, run_on_cpu_data data)
+{
+    XtensaCPU *cpu = XTENSA_CPU(cs);
+    CPUXtensaState *env = &cpu->env;
+    const uint64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (clock_get_hz(cpu->clock) == data.host_ulong) {
+        return;
+    }
+
+    /* CCOUNT carries on from where it is, at the new rate. */
+    env->sregs[CCOUNT] = env->ccount_base +
+        (uint32_t)clock_ns_to_ticks(cpu->clock, now - env->time_base);
+    env->ccount_base = env->sregs[CCOUNT];
+    env->time_base = now;
+    env->ccount_time = now;
+    clock_set_hz(cpu->clock, data.host_ulong);
+
+    for (int i = 0; i < env->config->nccompare; i++) {
+        const uint64_t ticks = (uint64_t)(env->sregs[CCOMPARE + i] - env->sregs[CCOUNT] - 1) + 1;
+
+        timer_mod(env->ccompare[i].timer, now + clock_ticks_to_ns(cpu->clock, ticks));
+    }
+}
+
+/*
+ * The cycle counter ticks at the CPU clock, whatever firmware has set that to,
+ * and instructions are paced to take their share of cycles at that clock.
+ */
+static void esp32s3_cpu_hz_changed(void *opaque, uint32_t hz)
+{
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+
+    for (int i = 0; i < ESP32S3_CPU_COUNT; i++) {
+        async_run_on_cpu(CPU(&s->cpu[i]), esp32s3_apply_cpu_hz, RUN_ON_CPU_HOST_ULONG(hz));
+    }
+    qatomic_set(&tcg_insn_pace_ps,
+                (uint64_t)s->board.cycles_per_insn_milli * 1000000000ULL / hz);
+}
