+static uint64_t esp32s3_rtc_now_ticks(Esp32s3RtcCntlState *s)
+{
+    return muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->time_base_ns,
+                    s->rtc_slowclk_freq, NANOSECONDS_PER_SECOND);
+}
+
+static void esp32s3_rtc_wake(Esp32s3RtcCntlState *s, uint32_t cause)
+{
+    s->sleeping = false;
+    timer_del(s->sleep_timer);
+    s->regs[ART_WAKEUP_CAUSE / 4] = cause;
+    qemu_set_irq(s->sleep_stall, 0);
+
+    if (s->deep_sleep) {
+        /* Waking from deep sleep is a reset that keeps RTC memory. */
+        s->reset_cause[0] = ESP32_DEEPSLEEP_RESET;
+        s->reset_cause[1] = ESP32_DEEPSLEEP_RESET;
+        qemu_irq_pulse(s->dig_reset_req);
+    } else {
+        s->regs[ART_INT_RAW / 4] |= ART_INT_SLP_WAKEUP;
     }
 }
 
+static void esp32s3_rtc_sleep_evaluate(Esp32s3RtcCntlState *s)
+{
+    uint32_t ena = s->regs[ART_WAKEUP_STATE / 4] >> ART_WAKEUP_ENA_S;
+    uint32_t conf = s->regs[ART_EXT_WAKEUP_CONF / 4];
+    uint32_t cause = 0;
+
+    if (!s->sleeping) {
+        return;
+    }
+
+    if (ena & ART_TRIG_GPIO && artemis_gpio_wakeup_pending(s->gpio)) {
+        cause |= ART_TRIG_GPIO;
+    }
+    if (ena & ART_TRIG_EXT1 &&
+        artemis_gpio_ext1_pending(s->gpio,
+                                  s->regs[ART_EXT_WAKEUP1 / 4] & ART_EXT1_SEL_M,
+                                  conf & ART_EXT1_LV)) {
+        cause |= ART_TRIG_EXT1;
+    }
+    if (ena & ART_TRIG_EXT0) {
+        uint32_t pad = s->gpio->rtcio[ART_RTCIO_EXT0_WORD] >> ART_RTCIO_EXT0_S;
+
+        if (artemis_gpio_get_level(s->gpio, pad & 0x1F) == !!(conf & ART_EXT0_LV)) {
+            cause |= ART_TRIG_EXT0;
+        }
+    }
+
+    if (ena & ART_TRIG_TIMER && s->regs[ART_SLP_TIMER1 / 4] & ART_TIMER_ALARM_EN) {
+        uint64_t target = (uint64_t)(s->regs[ART_SLP_TIMER1 / 4] & 0xFFFF) << 32 |
+                          s->regs[ART_SLP_TIMER0 / 4];
+        uint64_t now = esp32s3_rtc_now_ticks(s);
+
+        if (now >= target) {
+            cause |= ART_TRIG_TIMER;
+            s->regs[ART_INT_RAW / 4] |= ART_INT_MAIN_TIMER;
+        } else if (!cause) {
+            int64_t ns = muldiv64(target - now, NANOSECONDS_PER_SECOND,
+                                  s->rtc_slowclk_freq);
+            timer_mod(s->sleep_timer,
+                      qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ns + 1);
+        }
+    }
+
+    if (cause) {
+        esp32s3_rtc_wake(s, cause);
+    }
+}
