+/* Firmware resets a peripheral by raising its bit in SYSTEM_PERIP_RST_EN0 or EN1. */
+static void esp32s3_periph_reset(void *opaque, int reg, uint32_t bits)
+{
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+    static const struct {
+        int reg;
+        int bit;
+        hwaddr base;
+    } stored[] = {
+        { 0, 28, DR_REG_APB_SARADC_BASE },
+        { 0, 10, DR_REG_PCNT_BASE },
+        { 0, 8, DR_REG_UHCI0_BASE },
+        { 1, 8, DR_REG_LCD_CAM_BASE },
+    };
+    static const struct {
+        int reg;
+        int bit;
+        int uart;
+    } uarts[] = { { 0, 2, 0 }, { 0, 5, 1 }, { 1, 9, 2 } };
+
+    for (int i = 0; i < ARRAY_SIZE(uarts); i++) {
+        if (uarts[i].reg == reg && (bits & BIT(uarts[i].bit))) {
+            device_cold_reset(DEVICE(&s->uart[uarts[i].uart]));
+        }
+    }
+    if (reg == 1 && (bits & BIT(6))) {
+        device_cold_reset(DEVICE(&s->gdma));
+    }
+
+    for (int i = 0; i < ARRAY_SIZE(stored); i++) {
+        if (stored[i].reg == reg && (bits & BIT(stored[i].bit))) {
+            artemis_socregs_reset_range(&s->socregs, stored[i].base, 0x1000);
+        }
+    }
+    if (reg == 0) {
+        DeviceState *models[32] = {
+            [6] = DEVICE(&s->gpspi[0]),
+            [4] = DEVICE(&s->i2s[0]),
+            [7] = DEVICE(&s->i2c[0]),
+            [9] = DEVICE(&s->rmt),
+            [11] = DEVICE(&s->ledc),
+            [21] = DEVICE(&s->i2s[1]),
+            [16] = DEVICE(&s->gpspi[1]),
+            [18] = DEVICE(&s->i2c[1]),
+        };
+
+        for (int bit = 0; bit < 32; bit++) {
+            if (models[bit] && (bits & BIT(bit))) {
+                device_cold_reset(models[bit]);
+            }
+        }
+    }
+}
