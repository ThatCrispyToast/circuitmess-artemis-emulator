+/*
+ * The RTC watchdog, as timed on a watch. It counts the slow clock through up to
+ * four stages, each ending in an interrupt, a reset of the CPUs, of the digital
+ * system, or of the whole chip; a stage set to do nothing takes no time. Out of
+ * reset it guards the boot from flash on its own, until the bootloader takes
+ * it over. Stage 0 lasts twice what its register says.
+ */
+static bool esp32s3_rtc_wdt_counting(Esp32s3RtcCntlState *s)
+{
+    uint32_t config = s->regs[ART_WDTCONFIG0 / 4];
+
+    if (s->wdt_disable || !(config & (ART_WDT_EN | ART_WDT_FLASHBOOT))) {
+        return false;
+    }
+    return !(s->sleeping && (config & ART_WDT_PAUSE_SLP));
+}
+
+static int esp32s3_rtc_wdt_action(Esp32s3RtcCntlState *s, int stage)
+{
+    uint32_t config = s->regs[ART_WDTCONFIG0 / 4];
+
+    if (!(config & ART_WDT_EN)) {
+        /* Guarding the boot from flash */
+        return stage == 0 ? ART_WDT_RESET_SYSTEM : ART_WDT_OFF;
+    }
+    return config >> ART_WDT_STAGE_S(stage) & 7;
+}
+
+static void esp32s3_rtc_wdt_arm(Esp32s3RtcCntlState *s)
+{
+    uint64_t ticks;
+
+    timer_del(s->wdt_timer);
+    if (!esp32s3_rtc_wdt_counting(s)) {
+        return;
+    }
+    for (int skipped = 0; esp32s3_rtc_wdt_action(s, s->wdt_stage) == ART_WDT_OFF; skipped++) {
+        if (skipped == 4) {
+            return;
+        }
+        s->wdt_stage = (s->wdt_stage + 1) % 4;
+    }
+    ticks = s->regs[ART_WDTCONFIG1 / 4 + s->wdt_stage];
+    if (s->wdt_stage == 0) {
+        ticks <<= 1;
+    }
+    timer_mod(s->wdt_timer, s->wdt_stage_start +
+              muldiv64(ticks, NANOSECONDS_PER_SECOND, s->rtc_slowclk_freq));
+}
+
+static void esp32s3_rtc_wdt_restart(Esp32s3RtcCntlState *s)
+{
+    s->wdt_stage = 0;
+    s->wdt_stage_start = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    esp32s3_rtc_wdt_arm(s);
+}
+
+static void esp32s3_rtc_wdt_expired(void *opaque)
+{
+    Esp32s3RtcCntlState *s = ESP32S3_RTC_CNTL(opaque);
+    uint32_t config = s->regs[ART_WDTCONFIG0 / 4];
+    int action = esp32s3_rtc_wdt_action(s, s->wdt_stage);
+
+    s->wdt_stage = (s->wdt_stage + 1) % 4;
+    s->wdt_stage_start = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    switch (action) {
+    case ART_WDT_INTERRUPT:
+        s->regs[ART_INT_RAW / 4] |= ART_INT_WDT;
+        esp32s3_rtc_update_irq(s);
+        break;
+    case ART_WDT_RESET_CPU:
+        if (config & ART_WDT_PROCPU_RST) {
+            s->reset_cause[0] = ESP32_RTCWDT_CPU_RESET;
+            qemu_irq_pulse(s->cpu_reset_req[0]);
+        }
+        if (config & ART_WDT_APPCPU_RST) {
+            s->reset_cause[1] = ESP32_RTCWDT_CPU_RESET;
+            qemu_irq_pulse(s->cpu_reset_req[1]);
+        }
+        break;
+    case ART_WDT_RESET_SYSTEM:
+        s->reset_cause[0] = ESP32_RTCWDT_SYS_RESET;
+        s->reset_cause[1] = ESP32_RTCWDT_SYS_RESET;
+        qemu_irq_pulse(s->dig_reset_req);
+        break;
+    case ART_WDT_RESET_RTC:
+        /* The RTC domain goes too, this watchdog with it */
+        qemu_irq_pulse(s->rtc_reset_req);
+        return;
+    default:
+        break;
+    }
+    esp32s3_rtc_wdt_arm(s);
+}
