+static int64_t esp_counter_freeze(ESPVirtualCounter *counter)
+{
+    int64_t remaining = -1;
+
+    if (timer_pending(&counter->timer)) {
+        remaining = MAX(timer_expire_time_ns(&counter->timer) -
+                        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), 0);
+        timer_del(&counter->timer);
+    }
+    return remaining;
+}
+
+static void esp_counter_thaw(ESPVirtualCounter *counter, int64_t remaining)
+{
+    esp_virtual_counter_reenabled(counter);
+    if (remaining >= 0) {
+        timer_mod_ns(&counter->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + remaining);
+    }
+}
+
+void esp_timg_set_clock_gated(ESPTimgState *s, bool gated)
+{
+    ESPT0State *timers[] = { &s->t0, &s->t1 };
+
+    if (gated == s->clock_gated) {
+        return;
+    }
+    s->clock_gated = gated;
+
+    if (gated) {
+        for (int i = 0; i < ARRAY_SIZE(timers); i++) {
+            if (FIELD_EX32(timers[i]->config, TIMG_T0CONFIG, EN)) {
+                esp_t0_update_counter(timers[i]);
+            }
+            s->gated_remaining_ns[i] = esp_counter_freeze(&timers[i]->counter);
+        }
+        if (esp_wdt_enabled(&s->wdt)) {
+            esp_virtual_counter_update(&s->wdt.counter);
+        }
+        s->gated_remaining_ns[2] = esp_counter_freeze(&s->wdt.counter);
+    } else {
+        for (int i = 0; i < ARRAY_SIZE(timers); i++) {
+            esp_counter_thaw(&timers[i]->counter, s->gated_remaining_ns[i]);
+        }
+        esp_counter_thaw(&s->wdt.counter, s->gated_remaining_ns[2]);
+    }
+}
