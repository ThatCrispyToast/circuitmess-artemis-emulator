+int esp_gdma_stream_in_room(ESPGdmaState *s, uint32_t chan)
+{
+    DmaConfigState* state = &s->ch_conf[ESP_GDMA_IN_IDX][chan];
+    const uint32_t addr = esp_gdma_stream_position(s, chan, ESP_GDMA_IN_IDX);
+    GdmaLinkedList node;
